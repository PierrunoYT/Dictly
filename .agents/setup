#!/usr/bin/env bash
set -euo pipefail

echo "Checking Linux build and cross-build prerequisites"
# ALSA headers build microphone capture; xkbcommon-x11 and EGL run the window;
# Xvfb lets the desktop tests and live dictation run without a monitor.
packages="gcc-mingw-w64-x86-64-posix pkg-config libasound2-dev libxkbcommon-x11-0 libegl1 xvfb"
missing=""
for package in $packages; do
    dpkg -s "$package" >/dev/null 2>&1 || missing="$missing $package"
done
if [ -n "$missing" ]; then
    sudo apt-get update -qq
    # shellcheck disable=SC2086
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $missing
fi

export PATH="$HOME/.cargo/bin:$PATH"
if ! command -v rustup >/dev/null; then
    echo "Installing Rust"
    installer="$(mktemp)"
    trap 'rm -f "$installer"' EXIT
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o "$installer"
    sh "$installer" -y --profile minimal --default-toolchain stable
fi

echo "Preparing Rust targets and dependencies"
rustup component add clippy rustfmt
rustup target add x86_64-pc-windows-gnu
cargo fetch --locked --target x86_64-unknown-linux-gnu --target x86_64-pc-windows-gnu
echo "Ready: xvfb-run -a cargo test --locked; cargo build --release --locked --target x86_64-pc-windows-gnu"
